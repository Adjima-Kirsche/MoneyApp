<Window x:Class="MoneyApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MoneyApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Background="#FFEDDEDE">
        <Grid.Resources>
            <Style TargetType="TextBox">
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Padding" Value="8,0"/>
                <Style.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="10"/>
                    </Style>
                </Style.Resources>
            </Style>
        </Grid.Resources>
        <Rectangle HorizontalAlignment="Center" Height="82" Stroke="#FFC895FF" VerticalAlignment="Top" Width="800">
            <Rectangle.Fill>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFAA85CC" Offset="0.234"/>
                    <GradientStop Color="#FFA556F0" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <TextBlock HorizontalAlignment="Left" Margin="44,17,0,0" TextWrapping="Wrap" Text="Adjima's Money Application" VerticalAlignment="Top" Foreground="White" FontSize="36" FontWeight="Bold"/>
        <TextBlock HorizontalAlignment="Left" Margin="44,122,0,0" TextWrapping="Wrap" Text="Incomes" VerticalAlignment="Top" Foreground="#FF684DC3" FontSize="22" FontWeight="Bold"/>
        <TextBlock HorizontalAlignment="Left" Margin="44,175,0,0" TextWrapping="Wrap" Text="Expenses" VerticalAlignment="Top" Foreground="#FF684DC3" FontSize="22" FontWeight="Bold"/>
        <TextBlock x:Name="Wanted" HorizontalAlignment="Left" Margin="44,231,0,0" TextWrapping="Wrap" Text="Wanted Object Cost" VerticalAlignment="Top" Foreground="#FF684DC3" FontSize="22" FontWeight="Bold"/>
        <Button Content="Calculate" HorizontalAlignment="Left" Margin="307,352,0,0" VerticalAlignment="Top" Height="49" Width="160" Foreground="#FFF3F3F3" BorderBrush="#FFEED2D2" Click="Button_Click" FontSize="22" FontWeight="Bold" FontStyle="Italic">
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFB5A9CB" Offset="0.658"/>
                    <GradientStop Color="#FFA68BD2" Offset="1"/>
                </LinearGradientBrush>
            </Button.Background>
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="10"/>
                </Style>
            </Button.Resources>
        </Button>
        <TextBlock x:Name="Saving" HorizontalAlignment="Left" Margin="44,292,0,0" TextWrapping="Wrap" Text="Your Saving Cost" VerticalAlignment="Top" Foreground="#FF684DC3" FontSize="22" FontWeight="Bold"/>
        <TextBox x:Name="IncomeTXT" HorizontalAlignment="Left" Height="29" Margin="166,122,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="164"/>
        <TextBox x:Name="ExpenseTXT" HorizontalAlignment="Left" Height="29" Margin="166,175,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="164"/>
        <TextBox x:Name="WantedTXT" HorizontalAlignment="Left" Height="29" Margin="281,231,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="218"/>
        <TextBox x:Name="DayTXT" IsReadOnly="True" HorizontalAlignment="Left" Height="29" Margin="249,292,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="250"/>
        <TextBlock HorizontalAlignment="Left" Margin="360,122,0,0" TextWrapping="Wrap" Text="Bath/ Day" VerticalAlignment="Top" Foreground="#FF684DC3" FontSize="22" FontWeight="Bold"/>
        <TextBlock x:Name="Expense" HorizontalAlignment="Left" Margin="360,175,0,0" TextWrapping="Wrap" Text="Bath/ Day" VerticalAlignment="Top" Foreground="#FF684DC3" FontSize="22" FontWeight="Bold"/>
        <TextBlock HorizontalAlignment="Left" Margin="550,231,0,0" TextWrapping="Wrap" Text="Bath" VerticalAlignment="Top" Foreground="#FF684DC3" FontSize="22" FontWeight="Bold"/>
        <TextBlock HorizontalAlignment="Left" Margin="526,292,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Foreground="#FF684DC3" FontSize="22" FontWeight="Bold"><Run Text="Day"/><LineBreak/><Run/></TextBlock>
    </Grid>
</Window>